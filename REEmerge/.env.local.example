NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never prefix this with NEXT_PUBLIC_. It's only used by
# app/api/delete-account, to remove the auth user (something the
# publishable key structurally can't do). Get it from Supabase →
# Settings → API → "Secret keys".
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
